---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";

interface Props {
  title: string;
  description: string;
  /** Nav item to highlight in the header. */
  current?: "kids" | "seniors" | "blog" | "about";
  /** Absolute or root-relative path to a 1200x630 share image. */
  ogImage?: string;
  /** Set true on error/utility pages that shouldn't be indexed. */
  noindex?: boolean;
  /** Page language. Defaults to English. */
  lang?: "en" | "pl";
  /** Root-relative path to the equivalent page in the other language, if one exists. */
  altPath?: string;
}

const {
  title,
  description,
  current,
  ogImage = "/images/og-default.png",
  noindex = false,
  lang = "en",
  altPath,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// hreflang: only emitted when we actually know the equivalent page in the
// other language, so we never point to a page that doesn't exist yet.
const enURL = lang === "en" ? canonicalURL : altPath ? new URL(altPath, Astro.site) : null;
const plURL = lang === "pl" ? canonicalURL : altPath ? new URL(altPath, Astro.site) : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Consent Mode v2: default to "denied" until the visitor accepts the
         cookie banner (see the banner script near the end of <body>). Must
         run before gtag.js so no analytics cookie is set without consent. -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
      });
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z941PX9BHP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Z941PX9BHP');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    {enURL && <link rel="alternate" hreflang="en" href={enURL} />}
    {plURL && <link rel="alternate" hreflang="pl" href={plURL} />}
    {enURL && <link rel="alternate" hreflang="x-default" href={enURL} />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Alex Herek" />
    <meta property="og:locale" content={lang === "pl" ? "pl_PL" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon16x16.png" />
    <link rel="apple-touch-icon" href="/images/appletouchicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,450;0,9..144,600;0,9..144,700;1,9..144,500&family=Source+Sans+3:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body>
    <Header current={current} lang={lang} altPath={altPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />

    <div id="cookie-consent-banner" class="cookie-banner" hidden>
      <p>
        {lang === "pl" ? (
          <>Używamy plików cookie do analizy ruchu na stronie (Google Analytics). Możesz zaakceptować lub odrzucić — zobacz naszą <a href="/pl/privacy">politykę prywatności</a>.</>
        ) : (
          <>We use cookies to analyze site traffic (Google Analytics). You can accept or decline — see our <a href="/privacy">privacy policy</a>.</>
        )}
      </p>
      <div class="cookie-actions">
        <button id="cookie-reject" type="button" class="cta-btn cta-outline-cream">
          {lang === "pl" ? "Odrzuć" : "Decline"}
        </button>
        <button id="cookie-accept" type="button" class="cta-btn cta-primary">
          {lang === "pl" ? "Akceptuj" : "Accept"}
        </button>
      </div>
    </div>

    <script>
      (function () {
        const CONSENT_KEY = "ah_cookie_consent";
        const banner = document.getElementById("cookie-consent-banner");

        function updateConsent(granted) {
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          gtag("consent", "update", {
            analytics_storage: granted ? "granted" : "denied",
          });
        }

        let stored = null;
        try {
          stored = localStorage.getItem(CONSENT_KEY);
        } catch {
          // localStorage unavailable (private mode, blocked storage) — treat as no choice yet.
        }

        if (stored === "granted") {
          updateConsent(true);
        } else if (stored !== "denied" && banner) {
          banner.hidden = false;
        }

        const acceptBtn = document.getElementById("cookie-accept");
        const rejectBtn = document.getElementById("cookie-reject");

        acceptBtn?.addEventListener("click", () => {
          try {
            localStorage.setItem(CONSENT_KEY, "granted");
          } catch {}
          updateConsent(true);
          if (banner) banner.hidden = true;
        });

        rejectBtn?.addEventListener("click", () => {
          try {
            localStorage.setItem(CONSENT_KEY, "denied");
          } catch {}
          updateConsent(false);
          if (banner) banner.hidden = true;
        });
      })();
    </script>

    <script>
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("in"));
      }
    </script>
  </body>
</html>

<style>
  .cookie-banner {
    position: fixed;
    left: 20px;
    right: 20px;
    bottom: 20px;
    z-index: 999;
    max-width: 780px;
    margin: 0 auto;
    background: var(--navy);
    color: var(--cream);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-soft);
    padding: 20px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .cookie-banner p {
    margin: 0;
    flex: 1 1 320px;
    font-size: 0.86rem;
    line-height: 1.5;
    color: #cdd6dc;
  }
  .cookie-banner p a {
    color: var(--gold-light);
    text-decoration: underline;
  }
  .cookie-actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  .cookie-actions .cta-btn {
    padding: 10px 18px;
    font-size: 0.86rem;
  }
  @media (max-width: 560px) {
    .cookie-banner {
      left: 12px;
      right: 12px;
      bottom: 12px;
      padding: 18px;
    }
    .cookie-actions {
      width: 100%;
    }
    .cookie-actions .cta-btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>
