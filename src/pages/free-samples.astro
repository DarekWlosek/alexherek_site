---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Free Printable Samples — Alex Herek"
  description="Try free printable pages from Children of the World, Left Hand Brain Training, or Sharp Mind before you buy the full book."
  altPath="/pl/free-samples"
>
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a><span>/</span>Free Samples</div>
  </div>

  <div class="wrap intro">
    <div class="section-head reveal" style="text-align:left; margin: 0 0 30px;">
      <span class="eyebrow" style="color: var(--gold);">TRY BEFORE YOU BUY</span>
      <h1>Free pages, no strings attached.</h1>
      <p>Pick a shelf — we'll send a short printable sample straight to your inbox. No account, no credit card, just a PDF worth printing.</p>
      <div class="jump-links">
        <a href="#kids" class="jump-chip kids">↓ Kids sample</a>
        <a href="#seniors" class="jump-chip seniors">↓ Seniors sample</a>
      </div>
    </div>
  </div>

  <section id="kids" class="panel panel-kids">
    <div class="wrap">
      <div class="panel-shell reveal">
        <div class="panel-media panel-media-grid">
          <figure>
            <img src="/images/sample-argentina-flag.jpg" alt="Argentina flag and map coloring card" />
            <figcaption>ARGENTINA · FLAG</figcaption>
          </figure>
          <figure>
            <img src="/images/sample-argentina-nature.jpg" alt="Argentina nature scene coloring card — Patagonia glaciers and penguins" />
            <figcaption>ARGENTINA · NATURE</figcaption>
          </figure>
          <figure>
            <img src="/images/sample-argentina-city.jpg" alt="Argentina city scene coloring card — Buenos Aires and tango dancers" />
            <figcaption>ARGENTINA · CITY</figcaption>
          </figure>
          <figure>
            <img src="/images/sample-australia-flag.jpg" alt="Australia flag and map coloring card" />
            <figcaption>AUSTRALIA · FLAG</figcaption>
          </figure>
          <figure>
            <img src="/images/sample-australia-nature.jpg" alt="Australia nature scene coloring card — Uluru, wombat and platypus" />
            <figcaption>AUSTRALIA · NATURE</figcaption>
          </figure>
          <figure>
            <img src="/images/sample-australia-city.jpg" alt="Australia city scene coloring card — Sydney Opera House with koala and kangaroo" />
            <figcaption>AUSTRALIA · CITY</figcaption>
          </figure>
        </div>
        <div class="panel-body">
          <span class="eyebrow">FOR KIDS · AGES 3–10</span>
          <h2>6 pages from "Children of the World"</h2>
          <p class="desc">A free sample from our flagship series — two countries, six cards: a flag-and-map page, a children-in-nature scene, and a children-in-the-city scene for each, pulled straight from the full volumes.</p>
          <div class="includes">
            <div class="item"><span class="dot"></span>6 printable coloring pages (PDF)</div>
            <div class="item"><span class="dot"></span>A flag &amp; map page for each of the two countries, with its own color swatch guide</div>
            <div class="item"><span class="dot"></span>A nature scene and a city scene for each country</div>
            <div class="item"><span class="dot"></span>Sized for standard 8.5×11" / A4 printing</div>
          </div>
          <form class="lead-form" data-note="visual only — wire up to an email service before launch">
            <input type="email" placeholder="Your email address" required />
            <button class="cta-btn cta-kids" type="submit">Send my free pages →</button>
            <span class="fine">No spam, ever. Unsubscribe anytime. See our <a href="/privacy">privacy policy</a>.</span>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section id="seniors" class="panel panel-seniors">
    <div class="wrap">
      <div class="panel-shell reveal">
        <div class="panel-media">
          <img class="stack-1" src="/images/sm-sample-wordsearch.jpg" alt="Sample Sharp Mind page: word search" />
          <img class="stack-2" src="/images/sm-sample-logic.jpg" alt="Sample Sharp Mind page: logic puzzle" />
          <img class="stack-3" src="/images/sm-sample-memory.jpg" alt="Sample Sharp Mind page: memory exercise" />
        </div>
        <div class="panel-body">
          <span class="eyebrow">FOR SENIORS · LARGE PRINT</span>
          <h2>5 pages from Left Hand Brain Training &amp; Sharp Mind</h2>
          <p class="desc">A mixed sample pack — a couple of tracing drills and a couple of puzzles — so you can feel out both series before choosing where to start.</p>
          <div class="includes">
            <div class="item"><span class="dot"></span>5 printable large-print pages (PDF)</div>
            <div class="item"><span class="dot"></span>A short "how to use this book" guide</div>
            <div class="item"><span class="dot"></span>Sized for standard 8.5×11" / A4 printing</div>
          </div>
          <form class="lead-form" data-note="visual only — wire up to an email service before launch">
            <input type="email" placeholder="Your email address" required />
            <button class="cta-btn cta-seniors" type="submit">Send my free pages →</button>
            <span class="fine">No spam, ever. Unsubscribe anytime. See our <a href="/privacy">privacy policy</a>.</span>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding: 20px 28px 80px;">
    <div class="section-head reveal">
      <span class="eyebrow" style="color: var(--gold);">HOW IT WORKS</span>
      <h2 style="font-size: 1.9rem;">Three steps, five minutes.</h2>
    </div>
    <div class="how-strip reveal">
      <div class="how-item">
        <div class="how-num">1</div>
        <div><h3>Pick a shelf</h3><p>Choose the Kids or Seniors sample above.</p></div>
      </div>
      <div class="how-item">
        <div class="how-num">2</div>
        <div><h3>Check your inbox</h3><p>Your PDF lands within a couple of minutes.</p></div>
      </div>
      <div class="how-item">
        <div class="how-num">3</div>
        <div><h3>Print &amp; try it</h3><p>See how it feels before buying the full book.</p></div>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-bottom: 90px;">
    <div class="section-head reveal">
      <span class="eyebrow" style="color: var(--gold);">FREQUENTLY ASKED</span>
      <h2 style="font-size: 1.9rem;">Quick questions.</h2>
    </div>
    <div class="faq-list">
      <div class="faq-item reveal">
        <h3>Is the sample really free?</h3>
        <p>Yes — no payment, no trial period, no card required. Just an email address to send the PDF to.</p>
      </div>
      <div class="faq-item reveal">
        <h3>Can I get both the Kids and Seniors samples?</h3>
        <p>Of course — just submit both forms above with the same or different email addresses.</p>
      </div>
      <div class="faq-item reveal">
        <h3>Will you send me other emails?</h3>
        <p>Occasionally — new volume launches and the odd printable extra. You can unsubscribe with one click at any time.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding: 56px 0 20px; }
  .jump-links { display: flex; justify-content: center; gap: 14px; margin-top: 22px; flex-wrap: wrap; }
  .jump-chip { font-family: 'IBM Plex Mono', monospace; font-size: .76rem; letter-spacing: .04em; border: 1px solid var(--navy); border-radius: 100px; padding: 9px 18px; color: var(--navy); text-decoration: none; }
  .jump-chip.kids { border-color: var(--coral); color: var(--coral-deep); }
  .jump-chip.seniors { border-color: var(--gold); color: #8a6a1a; }

  .panel { padding: 70px 0; scroll-margin-top: 90px; }
  .panel-shell { border-radius: var(--radius-l); overflow: hidden; box-shadow: var(--shadow-soft); display: grid; grid-template-columns: 1fr 1fr; }
  @media (max-width: 900px) { .panel-shell { grid-template-columns: 1fr; } }
  .panel-kids .panel-shell { background: linear-gradient(160deg, var(--paper) 0%, var(--cream) 62%, var(--cream-deep) 100%); }
  .panel-seniors .panel-shell { background: linear-gradient(200deg,#22303f 0%, var(--navy) 55%, var(--navy-deep) 100%); color: var(--cream); }
  .panel-media { position: relative; padding: 40px; display: flex; align-items: center; justify-content: center; gap: 14px; }
  .panel-media img { border-radius: 8px; box-shadow: 0 16px 30px -14px rgba(0,0,0,.4); border: 5px solid #fff; }
  .panel-seniors .panel-media img { border: 5px solid rgba(255,255,255,.08); }
  .stack-1 { width: 150px; transform: rotate(-5deg) translateY(6px); }
  .stack-2 { width: 150px; transform: rotate(4deg) translateY(-8px); }
  .stack-3 { width: 150px; transform: rotate(-2deg) translateY(2px); }
  .panel-media-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    max-width: 460px;
  }
  .panel-media-grid figure { margin: 0; }
  .panel-media-grid img {
    width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 8px;
    box-shadow: 0 10px 20px -12px rgba(0,0,0,.35); border: 3px solid #fff;
  }
  .panel-media-grid figcaption {
    font-family: 'IBM Plex Mono', monospace; font-size: .56rem; letter-spacing: .04em;
    text-align: center; margin-top: 6px; color: var(--ink-soft);
  }
  @media (max-width: 480px) {
    .panel-media-grid { grid-template-columns: repeat(3, 1fr); max-width: 340px; gap: 8px; }
    .panel-media-grid figcaption { font-size: .5rem; }
  }
  .panel-body { padding: 48px 46px; display: flex; flex-direction: column; gap: 16px; justify-content: center; }
  .panel-kids .panel-body .eyebrow { color: var(--coral-deep); }
  .panel-seniors .panel-body .eyebrow { color: var(--gold-light); }
  .panel-body h2 { font-size: 1.9rem; }
  .panel-kids .panel-body h2 { color: var(--navy); }
  .panel-seniors .panel-body h2 { color: var(--paper); }
  .panel-body p.desc { font-size: .98rem; line-height: 1.6; max-width: 48ch; }
  .panel-kids .panel-body p.desc { color: var(--ink-soft); }
  .panel-seniors .panel-body p.desc { color: #cdd6dc; }
  .includes { display: flex; flex-direction: column; gap: 8px; margin: 4px 0; }
  .includes .item { display: flex; align-items: center; gap: 10px; font-size: .9rem; }
  .includes .item .dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  .panel-kids .includes .dot { background: var(--coral); }
  .panel-seniors .includes .dot { background: var(--gold); }
  .panel-kids .includes .item { color: var(--ink-soft); }
  .panel-seniors .includes .item { color: #c7d0d6; }

  .lead-form { display: flex; flex-direction: column; gap: 10px; margin-top: 8px; max-width: 380px; }
  .lead-form input { font-family: 'Source Sans 3', sans-serif; font-size: .94rem; padding: 12px 16px; border-radius: 10px; border: 1.5px solid rgba(27,38,53,.2); background: #fff; color: var(--ink); }
  .panel-seniors .lead-form input { border: 1.5px solid rgba(246,239,225,.25); background: rgba(255,255,255,.06); color: var(--paper); }
  .lead-form .fine { font-size: .74rem; }
  .panel-kids .lead-form .fine { color: var(--ink-soft); }
  .panel-seniors .lead-form .fine { color: #8fa0a9; }
  .lead-form .fine a { text-decoration: underline; color: inherit; }

  .how-strip { background: var(--paper); border: 1px solid rgba(198,153,47,.28); border-radius: var(--radius-l); padding: 36px 40px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  @media (max-width: 760px) { .how-strip { grid-template-columns: 1fr; } }
  .how-item { display: flex; gap: 14px; align-items: flex-start; }
  .how-num { width: 34px; height: 34px; border-radius: 50%; background: var(--navy); color: var(--gold-light); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-family: 'IBM Plex Mono', monospace; font-size: .78rem; font-weight: 700; }
  .how-item h3 { font-size: .96rem; color: var(--navy); margin-bottom: 4px; }
  .how-item p { margin: 0; font-size: .84rem; color: var(--ink-soft); line-height: 1.5; }

  .faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
  .faq-item { background: var(--paper); border: 1px solid rgba(198,153,47,.28); border-radius: var(--radius-m); padding: 22px 26px; }
  .faq-item h3 { font-size: 1rem; color: var(--navy); margin-bottom: 8px; }
  .faq-item p { margin: 0; color: var(--ink-soft); font-size: .92rem; line-height: 1.55; }
</style>

<script>
  // Visual-only forms for now — prevent navigation until wired to a real email service.
  document.querySelectorAll(".lead-form").forEach((form) => {
    form.addEventListener("submit", (e) => e.preventDefault());
  });
</script>
