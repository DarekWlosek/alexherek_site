---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Darmowe Przykładowe Strony — Alex Herek"
  description="Wypróbuj darmowe strony do druku z serii Dzieci Świata, Left Hand Brain Training czy Sprawny Umysł, zanim kupisz pełną książkę."
  altPath="/free-samples"
>
  <div class="wrap">
    <div class="crumb"><a href="/pl">Strona główna</a><span>/</span>Darmowe próbki</div>
  </div>
  <div class="wrap intro">
    <div class="section-head reveal" style="text-align:left; margin: 0 0 30px;">
      <span class="eyebrow" style="color: var(--gold);">WYPRÓBUJ PRZED ZAKUPEM</span>
      <h1>Darmowe strony, bez żadnych zobowiązań.</h1>
      <p>Wybierz półkę — wyślemy krótką próbkę do druku prosto na Twoją skrzynkę. Bez zakładania konta, bez karty kredytowej — po prostu PDF wart wydrukowania.</p>
      <div class="jump-links">
        <a href="#kids" class="jump-chip kids">↓ Próbka dla dzieci</a>
        <a href="#seniors" class="jump-chip seniors">↓ Próbka dla seniorów</a>
      </div>
    </div>
  </div>
  <section id="kids" class="panel panel-kids">
    <div class="wrap">
      <div class="panel-shell reveal">
        <div class="panel-media panel-media-grid">
          <figure>
            <img src="/images/sample-argentina-flag.jpg" alt="Karta do kolorowania — flaga i mapa Argentyny" />
            <figcaption>ARGENTYNA · FLAGA</figcaption>
          </figure>
          <figure>
            <img src="/images/sample-argentina-nature.jpg" alt="Karta do kolorowania — scena przyrodnicza w Argentynie, lodowce Patagonii i pingwiny" />
            <figcaption>ARGENTYNA · PRZYRODA</figcaption>
          </figure>
          <figure>
            <img src="/images/sample-argentina-city.jpg" alt="Karta do kolorowania — scena miejska w Argentynie, Buenos Aires i tancerze tanga" />
            <figcaption>ARGENTYNA · MIASTO</figcaption>
          </figure>
          <figure>
            <img src="/images/sample-australia-flag.jpg" alt="Karta do kolorowania — flaga i mapa Australii" />
            <figcaption>AUSTRALIA · FLAGA</figcaption>
          </figure>
          <figure>
            <img src="/images/sample-australia-nature.jpg" alt="Karta do kolorowania — scena przyrodnicza w Australii, Uluru, wombat i dziobak" />
            <figcaption>AUSTRALIA · PRZYRODA</figcaption>
          </figure>
          <figure>
            <img src="/images/sample-australia-city.jpg" alt="Karta do kolorowania — scena miejska w Australii, Opera w Sydney z koalą i kangurem" />
            <figcaption>AUSTRALIA · MIASTO</figcaption>
          </figure>
        </div>
        <div class="panel-body">
          <span class="eyebrow">DLA DZIECI · WIEK 3–10</span>
          <h2>6 stron z serii „Dzieci Świata i ich kultury”</h2>
          <p class="desc">Darmowa próbka z naszej flagowej serii — dwa kraje, sześć kart: strona z flagą i mapą, scena z dziećmi na łonie natury oraz scena miejska dla każdego kraju, wprost z pełnych tomów.</p>
          <div class="includes">
            <div class="item"><span class="dot"></span>6 stron do wydruku i kolorowania (PDF)</div>
            <div class="item"><span class="dot"></span>Strona z flagą i mapą dla każdego z dwóch krajów, wraz z własnym wzornikiem kolorów</div>
            <div class="item"><span class="dot"></span>Scena przyrodnicza i scena miejska dla każdego kraju</div>
            <div class="item"><span class="dot"></span>Format dopasowany do standardowego druku 8,5×11" / A4</div>
          </div>
          <form class="lead-form" data-list="kids-pl" novalidate>
            <input type="text" name="name" placeholder="Twoje imię" autocomplete="given-name" required />
            <input type="email" name="email" placeholder="Twój adres e-mail" autocomplete="email" required />
            <input type="text" name="company" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAEcxM-7TnesT20ZP" data-theme="light"></div>
            <button class="cta-btn cta-kids" type="submit">Wyślij mi darmowe strony →</button>
            <p class="form-status" role="status" aria-live="polite"></p>
            <span class="fine">Zero spamu. Wypisz się w każdej chwili. Zobacz naszą <a href="/pl/privacy">politykę prywatności</a>.</span>
          </form>
        </div>
      </div>
    </div>
  </section>
  <section id="seniors" class="panel panel-seniors">
    <div class="wrap">
      <div class="panel-shell reveal">
        <div class="panel-media">
          <img class="stack-1" src="/images/sm-sample-wordsearch.jpg" alt="Przykładowa strona Sprawny Umysł: wyszukiwanka słów" />
          <img class="stack-2" src="/images/sm-sample-logic.jpg" alt="Przykładowa strona Sprawny Umysł: łamigłówka logiczna" />
          <img class="stack-3" src="/images/sm-sample-memory.jpg" alt="Przykładowa strona Sprawny Umysł: ćwiczenie pamięci" />
        </div>
        <div class="panel-body">
          <span class="eyebrow">DLA SENIORÓW · DUŻY DRUK</span>
          <h2>5 stron z serii Left Hand Brain Training i Sprawny Umysł</h2>
          <p class="desc">Mieszany zestaw próbek — kilka ćwiczeń z odrysowywania i kilka łamigłówek — żebyś mógł/mogła poczuć obie serie, zanim zdecydujesz, od czego zacząć.</p>
          <div class="includes">
            <div class="item"><span class="dot"></span>5 stron do wydruku dużą czcionką (PDF)</div>
            <div class="item"><span class="dot"></span>Krótki przewodnik „jak korzystać z tej książki”</div>
            <div class="item"><span class="dot"></span>Format dopasowany do standardowego druku 8,5×11" / A4</div>
          </div>
          <form class="lead-form" data-list="seniors-pl" novalidate>
            <input type="text" name="name" placeholder="Twoje imię" autocomplete="given-name" required />
            <input type="email" name="email" placeholder="Twój adres e-mail" autocomplete="email" required />
            <input type="text" name="company" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAEcxM-7TnesT20ZP" data-theme="dark"></div>
            <button class="cta-btn cta-seniors" type="submit">Wyślij mi darmowe strony →</button>
            <p class="form-status" role="status" aria-live="polite"></p>
            <span class="fine">Zero spamu. Wypisz się w każdej chwili. Zobacz naszą <a href="/pl/privacy">politykę prywatności</a>.</span>
          </form>
        </div>
      </div>
    </div>
  </section>
  <section class="wrap" style="padding: 20px 28px 80px;">
    <div class="section-head reveal">
      <span class="eyebrow" style="color: var(--gold);">JAK TO DZIAŁA</span>
      <h2 style="font-size: 1.9rem;">Trzy kroki, pięć minut.</h2>
    </div>
    <div class="how-strip reveal">
      <div class="how-item">
        <div class="how-num">1</div>
        <div><h3>Wybierz półkę</h3><p>Wybierz powyżej próbkę dla dzieci lub dla seniorów.</p></div>
      </div>
      <div class="how-item">
        <div class="how-num">2</div>
        <div><h3>Sprawdź skrzynkę</h3><p>Twój PDF dotrze w ciągu kilku minut.</p></div>
      </div>
      <div class="how-item">
        <div class="how-num">3</div>
        <div><h3>Wydrukuj i wypróbuj</h3><p>Sprawdź, jak to działa, zanim kupisz pełną książkę.</p></div>
      </div>
    </div>
  </section>
  <section class="wrap" style="padding-bottom: 90px;">
    <div class="section-head reveal">
      <span class="eyebrow" style="color: var(--gold);">NAJCZĘŚCIEJ ZADAWANE PYTANIA</span>
      <h2 style="font-size: 1.9rem;">Krótkie pytania.</h2>
    </div>
    <div class="faq-list">
      <div class="faq-item reveal">
        <h3>Czy próbka naprawdę jest darmowa?</h3>
        <p>Tak — bez opłat, bez okresu próbnego, bez karty. Wystarczy adres e-mail, na który wyślemy PDF.</p>
      </div>
      <div class="faq-item reveal">
        <h3>Czy mogę otrzymać próbkę zarówno dla dzieci, jak i dla seniorów?</h3>
        <p>Oczywiście — po prostu wypełnij oba formularze powyżej, tym samym lub różnymi adresami e-mail.</p>
      </div>
      <div class="faq-item reveal">
        <h3>Czy będziecie wysyłać mi inne wiadomości?</h3>
        <p>Od czasu do czasu — informacje o nowych tomach i dodatkowych materiałach do druku. Możesz wypisać się jednym kliknięciem w każdej chwili.</p>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .intro { padding: 56px 0 20px; }
  .jump-links { display: flex; justify-content: center; gap: 14px; margin-top: 22px; flex-wrap: wrap; }
  .jump-chip { font-family: 'IBM Plex Mono', monospace; font-size: .76rem; letter-spacing: .04em; border: 1px solid var(--navy); border-radius: 100px; padding: 9px 18px; color: var(--navy); text-decoration: none; }
  .jump-chip.kids { border-color: var(--coral); color: var(--coral-deep); }
  .jump-chip.seniors { border-color: var(--gold); color: #8a6a1a; }
  .panel { padding: 70px 0; scroll-margin-top: 90px; }
  .panel-shell { border-radius: var(--radius-l); overflow: hidden; box-shadow: var(--shadow-soft); display: grid; grid-template-columns: 1fr 1fr; }
  @media (max-width: 900px) { .panel-shell { grid-template-columns: 1fr; } }
  .panel-kids .panel-shell { background: linear-gradient(160deg, var(--paper) 0%, var(--cream) 62%, var(--cream-deep) 100%); }
  .panel-seniors .panel-shell { background: linear-gradient(200deg,#22303f 0%, var(--navy) 55%, var(--navy-deep) 100%); color: var(--cream); }
  .panel-media { position: relative; padding: 40px; display: flex; align-items: center; justify-content: center; gap: 14px; }
  .panel-media img { border-radius: 8px; box-shadow: 0 16px 30px -14px rgba(0,0,0,.4); border: 5px solid #fff; }
  .panel-seniors .panel-media img { border: 5px solid rgba(255,255,255,.08); }
  .stack-1 { width: 150px; transform: rotate(-5deg) translateY(6px); }
  .stack-2 { width: 150px; transform: rotate(4deg) translateY(-8px); }
  .stack-3 { width: 150px; transform: rotate(-2deg) translateY(2px); }
  .panel-media-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    max-width: 460px;
  }
  .panel-media-grid figure { margin: 0; }
  .panel-media-grid img {
    width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 8px;
    box-shadow: 0 10px 20px -12px rgba(0,0,0,.35); border: 3px solid #fff;
  }
  .panel-media-grid figcaption {
    font-family: 'IBM Plex Mono', monospace; font-size: .56rem; letter-spacing: .04em;
    text-align: center; margin-top: 6px; color: var(--ink-soft);
  }
  @media (max-width: 480px) {
    .panel-media-grid { grid-template-columns: repeat(3, 1fr); max-width: 340px; gap: 8px; }
    .panel-media-grid figcaption { font-size: .5rem; }
  }
  .panel-body { padding: 48px 46px; display: flex; flex-direction: column; gap: 16px; justify-content: center; }
  .panel-kids .panel-body .eyebrow { color: var(--coral-deep); }
  .panel-seniors .panel-body .eyebrow { color: var(--gold-light); }
  .panel-body h2 { font-size: 1.9rem; }
  .panel-kids .panel-body h2 { color: var(--navy); }
  .panel-seniors .panel-body h2 { color: var(--paper); }
  .panel-body p.desc { font-size: .98rem; line-height: 1.6; max-width: 48ch; }
  .panel-kids .panel-body p.desc { color: var(--ink-soft); }
  .panel-seniors .panel-body p.desc { color: #cdd6dc; }
  .includes { display: flex; flex-direction: column; gap: 8px; margin: 4px 0; }
  .includes .item { display: flex; align-items: center; gap: 10px; font-size: .9rem; }
  .includes .item .dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  .panel-kids .includes .dot { background: var(--coral); }
  .panel-seniors .includes .dot { background: var(--gold); }
  .panel-kids .includes .item { color: var(--ink-soft); }
  .panel-seniors .includes .item { color: #c7d0d6; }
  .lead-form { display: flex; flex-direction: column; gap: 10px; margin-top: 8px; max-width: 380px; }
  .lead-form input { font-family: 'Source Sans 3', sans-serif; font-size: .94rem; padding: 12px 16px; border-radius: 10px; border: 1.5px solid rgba(27,38,53,.2); background: #fff; color: var(--ink); }
  .panel-seniors .lead-form input { border: 1.5px solid rgba(246,239,225,.25); background: rgba(255,255,255,.06); color: var(--paper); }
  .lead-form .fine { font-size: .74rem; }
  .panel-kids .lead-form .fine { color: var(--ink-soft); }
  .panel-seniors .lead-form .fine { color: #8fa0a9; }
  .lead-form .fine a { text-decoration: underline; color: inherit; }
  /* Pole-pułapka (honeypot): zostaje w DOM, ale poza kolejnością tabulacji,
     żeby czytniki ekranu je pomijały, i jest wizualnie ukryte poza ekranem,
     więc prawdziwi odwiedzający nigdy go nie widzą ani nie wypełniają.
     Proste boty wypełniające każde pole formularza "wpadają" w nie. */
  .hp-field { position: absolute; left: -5000px; width: 1px; height: 1px; overflow: hidden; opacity: 0; }
  .form-status { font-size: .82rem; min-height: 1.2em; margin: 0; }
  .form-status.is-error { color: #c0392b; font-weight: 600; }
  .panel-seniors .form-status.is-error { color: #ff8a7a; }
  .form-success { font-size: .96rem; font-weight: 600; margin: 8px 0 0; }
  .panel-kids .form-success { color: var(--navy); }
  .panel-seniors .form-success { color: var(--gold-light); }
  .how-strip { background: var(--paper); border: 1px solid rgba(198,153,47,.28); border-radius: var(--radius-l); padding: 36px 40px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  @media (max-width: 760px) { .how-strip { grid-template-columns: 1fr; } }
  .how-item { display: flex; gap: 14px; align-items: flex-start; }
  .how-num { width: 34px; height: 34px; border-radius: 50%; background: var(--navy); color: var(--gold-light); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-family: 'IBM Plex Mono', monospace; font-size: .78rem; font-weight: 700; }
  .how-item h3 { font-size: .96rem; color: var(--navy); margin-bottom: 4px; }
  .how-item p { margin: 0; font-size: .84rem; color: var(--ink-soft); line-height: 1.5; }
  .faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
  .faq-item { background: var(--paper); border: 1px solid rgba(198,153,47,.28); border-radius: var(--radius-m); padding: 22px 26px; }
  .faq-item h3 { font-size: 1rem; color: var(--navy); margin-bottom: 8px; }
  .faq-item p { margin: 0; color: var(--ink-soft); font-size: .92rem; line-height: 1.55; }
</style>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  // Submits each lead-magnet form to our own Cloudflare Pages Function
  // (/api/subscribe), which verifies the Turnstile token server-side and
  // then hands the signup to Kit. Kit owns the double opt-in confirmation
  // email from there — this page never marks anyone as "subscribed".
  document.querySelectorAll<HTMLFormElement>(".lead-form").forEach((form) => {
    const statusEl = form.querySelector<HTMLElement>(".form-status");
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    function setStatus(msg: string, isError: boolean) {
      if (!statusEl) return;
      statusEl.textContent = msg;
      statusEl.classList.toggle("is-error", isError);
    }
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const turnstileToken = data.get("cf-turnstile-response");
      if (!turnstileToken) {
        setStatus("Proszę ukończyć weryfikację powyżej.", true);
        return;
      }
      if (button) button.disabled = true;
      setStatus("Wysyłanie…", false);
      try {
        const res = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: data.get("name"),
            email: data.get("email"),
            list: form.dataset.list,
            token: turnstileToken,
            company: data.get("company"), // honeypot — powinno zawsze być puste
          }),
        });
        const result = await res.json();
        if (result.ok) {
          form.innerHTML =
            '<p class="form-success">✓ Już prawie gotowe — sprawdź skrzynkę i potwierdź adres e-mail, aby otrzymać PDF.</p>';
        } else {
          setStatus("Coś poszło nie tak. Spróbuj ponownie za chwilę.", true);
          if (button) button.disabled = false;
        }
      } catch {
        setStatus("Błąd sieci — spróbuj ponownie.", true);
        if (button) button.disabled = false;
      }
    });
  });
</script>
