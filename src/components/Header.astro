---
interface Props {
  /** Which top-level nav item to highlight, if any. */
  current?: "kids" | "seniors" | "cooking" | "blog" | "about";
  /** Site language. Defaults to English. */
  lang?: "en" | "pl";
  /** Where the language-switcher pill should link to. Defaults to each locale's homepage. */
  altPath?: string;
}

const { current, lang = "en", altPath } = Astro.props;
const p = lang === "pl" ? "/pl" : "";

const t =
  lang === "pl"
    ? { kids: "Dzieci", seniors: "Seniorzy", cooking: "Kuchnia", blog: "Blog", about: "O autorze", tag: "KSIĄŻKI DLA DZIECI I SENIORÓW" }
    : { kids: "Kids", seniors: "Seniors", cooking: "Cooking", blog: "Blog", about: "About", tag: "CHILDREN'S & SENIOR BRAIN BOOKS" };
---

<header>
  <div class="nav">
    <a href={p || "/"} class="brand">
      <img src="/images/seal.png" alt="" width="34" height="34" />
      <span>
        <span class="name">Alex&nbsp;Herek</span>
        <span class="tag">{t.tag}</span>
      </span>
    </a>
    <div class="nav-right">
      <nav class="links">
        <a href={`${p}/kids`} class={current === "kids" ? "current" : ""}>{t.kids}</a>
        <a href={`${p}/seniors`} class={current === "seniors" ? "current" : ""}>{t.seniors}</a>
        <a href={`${p}/cooking`} class={current === "cooking" ? "current" : ""}>{t.cooking}</a>
        <a href={`${p}/blog`} class={current === "blog" ? "current" : ""}>{t.blog}</a>
        <a href={`${p}/about`} class={current === "about" ? "current" : ""}>{t.about}</a>
      </nav>
      <div class="lang-switch" role="group" aria-label={lang === "pl" ? "Wybór języka" : "Language selector"}>
        {lang === "en" ? (
          <span class="lang-opt active" aria-current="true">EN</span>
        ) : (
          <a href={altPath ?? "/"} class="lang-opt">EN</a>
        )}
        {lang === "pl" ? (
          <span class="lang-opt active" aria-current="true">PL</span>
        ) : (
          <a href={altPath ?? "/pl/"} class="lang-opt">PL</a>
        )}
      </div>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(246, 239, 225, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(198, 153, 47, 0.35);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    padding: 14px 28px;
    max-width: 1180px;
    margin: 0 auto;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand .name {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: 1.08rem;
    line-height: 1;
    color: var(--ink);
  }
  .brand .tag {
    display: block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--gold);
    margin-top: 3px;
  }
  nav.links {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 20px;
    white-space: nowrap;
  }
  nav.links a {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--navy);
    position: relative;
    padding: 4px 0;
    text-decoration: none;
  }
  nav.links a.current {
    color: var(--gold);
  }
  nav.links a.current::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
  }
  .nav-right {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    flex-shrink: 0;
    gap: 16px;
  }
  .lang-switch {
    display: flex;
    align-items: center;
    background: rgba(27, 38, 53, 0.07);
    border-radius: 100px;
    padding: 3px;
    gap: 2px;
    flex-shrink: 0;
  }
  .lang-opt {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 5px 11px;
    border-radius: 100px;
    text-decoration: none;
    color: var(--ink-soft);
    line-height: 1;
  }
  .lang-opt.active {
    background: var(--navy);
    color: var(--paper);
  }
  .lang-opt:not(.active):hover {
    color: var(--navy);
  }
  @media (max-width: 1100px) {
    .brand .tag {
      display: none;
    }
  }
  @media (max-width: 820px) {
    nav.links {
      display: none;
    }
  }
</style>
